# systemd unit for Eklunda on the Raspberry Pi.
# Adjust User and the paths, then:
#   sudo cp deploy/eklunda.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now eklunda

[Unit]
Description=Eklunda
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/opt/eklunda
ExecStart=/opt/eklunda/Eklunda.Web
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
# Only Caddy talks to the app; it terminates HTTPS and forwards X-Forwarded-Proto.
Environment=ASPNETCORE_URLS=http://localhost:5000
Environment="ConnectionStrings__Default=Host=localhost;Port=5432;Database=eklunda;Username=eklunda;Password=CHANGE-ME"

[Install]
WantedBy=multi-user.target
