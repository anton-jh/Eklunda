<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111418" />
    <meta name="color-scheme" content="dark" />
    <title>@(ViewData["Title"] is string title ? $"{title} – Eklunda" : "Eklunda")</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    @if (Eklunda.Web.Core.Users.UserAuthentication.GetUserId(User) is { } userId)
    {
        <meta name="eklunda-user" content="@userId.Value" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (ViewData["HideMenu"] is not true)
    {
        <header class="appbar">
            <a class="appbar-title" asp-page="/Pages/Index">Eklunda</a>
            <partial name="/Pages/Shared/_PushWarning.cshtml" />
            <button class="icon-button" type="button" popovertarget="menu" aria-label="Meny">
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
            </button>
        </header>

        <div id="menu" class="menu-sheet" popover>
            <div class="appbar">
                <a class="appbar-title" asp-page="/Pages/Index">Eklunda</a>
                <button class="icon-button" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Stäng meny">
                    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
            </div>
            <partial name="/Pages/Shared/_Menu.cshtml" />
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
