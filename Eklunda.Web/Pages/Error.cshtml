@page
@model ErrorModel
@{
    ViewData["Title"] = "Fel";
}

<div class="prose">
    <header class="page-header">
        <h1>Något gick fel</h1>
    </header>

    <p>Ett fel uppstod när sidan skulle visas.</p>

    @if (Model.ShowRequestId)
    {
        <p>Request ID: <code>@Model.RequestId</code></p>
    }

    <p><a asp-page="/Pages/Index">Till startsidan</a></p>
</div>
