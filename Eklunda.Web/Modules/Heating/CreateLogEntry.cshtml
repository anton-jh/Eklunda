@page
@model Eklunda.Web.Modules.Heating.CreateLogEntryModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111418" />
    <meta name="color-scheme" content="dark" />
    <title>Värmelogg</title>
    <style>
        :root {
            --bg: #111418;
            --surface: #1a1f25;
            --border: #2a3139;
            --text: #e6e9ed;
            --muted: #8b949e;
            --accent: #f08a3e;
            --accent-text: #1a1007;
            --ok: #3fb950;

            color-scheme: dark;
            background: var(--bg);
            -webkit-text-size-adjust: 100%;
        }

        body {
            margin: 0;
            color: var(--text);
            font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        main {
            max-width: 30rem;
            margin: 0 auto;
            padding: 1rem 1rem calc(6rem + env(safe-area-inset-bottom));
        }

        header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        h1 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 650;
        }

        .now {
            margin: 0;
            color: var(--muted);
            font-size: .875rem;
            font-variant-numeric: tabular-nums;
        }

        .toast {
            margin: 0 0 1rem;
            padding: .75rem 1rem;
            border-radius: .75rem;
            background: color-mix(in srgb, var(--ok) 15%, transparent);
            color: var(--ok);
            font-weight: 600;
        }

        fieldset {
            margin: 0 0 1rem;
            padding: .25rem 1rem;
            border: 1px solid var(--border);
            border-radius: .875rem;
            background: var(--surface);
        }

        legend {
            float: left;
            width: 100%;
            padding: .75rem 0 .25rem;
            color: var(--muted);
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        legend + * {
            clear: both;
        }

        /* Temperature rows */
        .temp {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-height: 3.25rem;
            border-top: 1px solid var(--border);
        }

        legend + .temp {
            border-top: 0;
        }

        .temp span {
            flex: 1;
        }

        .temp input {
            width: 5.5rem;
            padding: .5rem .75rem;
            border: 1px solid var(--border);
            border-radius: .5rem;
            background: var(--bg);
            color: var(--text);
            font: inherit;
            font-size: 1.25rem;
            font-variant-numeric: tabular-nums;
            text-align: right;
            -moz-appearance: textfield;
        }

        .temp input::-webkit-inner-spin-button,
        .temp input::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .temp em {
            width: 1.5rem;
            color: var(--muted);
            font-style: normal;
        }

        /* Fire toggles */
        .toggles {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .5rem;
            padding-bottom: .75rem;
        }

        .toggle {
            position: relative;
        }

        .toggle input {
            position: absolute;
            opacity: 0;
            inset: 0;
            margin: 0;
        }

        .toggle span {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 3rem;
            border: 1px solid var(--border);
            border-radius: .625rem;
            background: var(--bg);
            font-weight: 500;
            user-select: none;
            transition: background-color .15s, border-color .15s, color .15s;
        }

        .toggle input:checked + span {
            border-color: var(--accent);
            background: color-mix(in srgb, var(--accent) 18%, transparent);
            color: var(--accent);
        }

        /* Notes */
        textarea {
            box-sizing: border-box;
            width: 100%;
            margin-bottom: .75rem;
            padding: .625rem .75rem;
            border: 1px solid var(--border);
            border-radius: .5rem;
            background: var(--bg);
            color: var(--text);
            font: inherit;
            resize: vertical;
        }

        textarea::placeholder {
            color: var(--muted);
        }

        /* Focus */
        input:focus-visible,
        textarea:focus-visible,
        .toggle input:focus-visible + span,
        button:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        input:focus,
        textarea:focus {
            border-color: var(--accent);
        }

        /* Sticky save button */
        .actions {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom));
            background: linear-gradient(transparent, var(--bg) 35%);
        }

        button {
            display: block;
            width: 100%;
            max-width: 28rem;
            margin: 0 auto;
            min-height: 3.25rem;
            border: 0;
            border-radius: .75rem;
            background: var(--accent);
            color: var(--accent-text);
            font: inherit;
            font-size: 1.0625rem;
            font-weight: 650;
            cursor: pointer;
        }

        button:active {
            filter: brightness(.9);
        }
    </style>
</head>
<body>
    <main>
        <header>
            <h1>Uppvärmningslogg</h1>
            <p class="now">@DateTime.Now.ToString("ddd d MMM, HH:mm", System.Globalization.CultureInfo.GetCultureInfo("sv-SE"))</p>
        </header>

        @if (Model.Saved)
        {
            <p class="toast" role="status">Sparat ✓</p>
        }

        <form method="post" autocomplete="off">
            <fieldset>
                <legend>Ackumulatortank</legend>
                <label class="temp">
                    <span>Övre</span>
                    <input name="tempTankUpper" type="number" inputmode="numeric" min="0" max="110" />
                    <em>°C</em>
                </label>
                <label class="temp">
                    <span>Mitten</span>
                    <input name="tempTankMid" type="number" inputmode="numeric" min="0" max="110" />
                    <em>°C</em>
                </label>
                <label class="temp">
                    <span>Nedre</span>
                    <input name="tempTankLower" type="number" inputmode="numeric" min="0" max="110" />
                    <em>°C</em>
                </label>
            </fieldset>

            <fieldset>
                <legend>Panna</legend>
                <label class="temp">
                    <span>Temperatur</span>
                    <input name="tempBoiler" type="number" inputmode="numeric" min="0" max="150" />
                    <em>°C</em>
                </label>
            </fieldset>

            <fieldset>
                <legend>Åtgärder</legend>
                <div class="toggles">
                    <label class="toggle">
                        <input name="litFire" type="checkbox" value="true" />
                        <span>Tänt</span>
                    </label>
                    <label class="toggle">
                        <input name="stokedFire" type="checkbox" value="true" />
                        <span>Lagt på</span>
                    </label>
                </div>
            </fieldset>

            <fieldset>
                <legend><label for="notes">Övrigt</label></legend>
                <textarea id="notes" name="notes" rows="3" placeholder="Valfritt"></textarea>
            </fieldset>

            <div class="actions">
                <button type="submit">Spara</button>
            </div>
        </form>
    </main>
</body>
</html>
