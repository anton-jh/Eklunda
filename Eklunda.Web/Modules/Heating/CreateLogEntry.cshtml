@page
@model Eklunda.Web.Modules.Heating.CreateLogEntryModel
@using Eklunda.Web.Modules.Heating.Models
@{
    ViewData["Title"] = "Ny post";
}

@section Scripts {
    <script>
        // Radios can't normally be unchecked; let a second tap clear the choice (the field is optional).
        document.querySelectorAll("[data-clearable] input[type=radio]").forEach(radio => {
            let wasChecked = false;
            radio.addEventListener("pointerdown", () => wasChecked = radio.checked);
            radio.addEventListener("click", () => {
                if (wasChecked) radio.checked = false;
                wasChecked = false;
            });
        });
    </script>
}
<nav class="topnav">
    <a asp-page="Log">‹ Logg</a>
</nav>

<header class="page-header">
    <h1>Uppvärmningslogg</h1>
    <p class="now">@DateTime.Now.ToString("ddd d MMM, HH:mm", System.Globalization.CultureInfo.GetCultureInfo("sv-SE"))</p>
</header>

@if (Model.Saved)
{
    <p class="toast" role="status">Sparat ✓</p>
}

<form method="post" autocomplete="off">
    <fieldset>
        <legend>Ackumulatortank</legend>
        <label class="temp">
            <span>Övre</span>
            <input name="tempTankUpper" type="number" inputmode="numeric" min="0" max="110" />
            <em>°C</em>
        </label>
        <label class="temp">
            <span>Mitten</span>
            <input name="tempTankMid" type="number" inputmode="numeric" min="0" max="110" />
            <em>°C</em>
        </label>
        <label class="temp">
            <span>Nedre</span>
            <input name="tempTankLower" type="number" inputmode="numeric" min="0" max="110" />
            <em>°C</em>
        </label>
    </fieldset>

    <fieldset>
        <legend>Panna</legend>
        <label class="temp">
            <span>Temperatur</span>
            <input name="tempBoiler" type="number" inputmode="numeric" min="0" max="150" />
            <em>°C</em>
        </label>
    </fieldset>

    <fieldset>
        <legend>Kvar i pannan</legend>
        @* Optional: tap the selected option again to clear it. *@
        <div class="toggles toggles-3" data-clearable>
            <label class="toggle">
                <input name="amountLeftInFire" type="radio" value="@AmountLeftInFire.None" />
                <span>Inget</span>
            </label>
            <label class="toggle">
                <input name="amountLeftInFire" type="radio" value="@AmountLeftInFire.Some" />
                <span>Lite</span>
            </label>
            <label class="toggle">
                <input name="amountLeftInFire" type="radio" value="@AmountLeftInFire.Much" />
                <span>Mycket</span>
            </label>
        </div>
    </fieldset>

    <fieldset>
        <legend>Åtgärder</legend>
        <div class="toggles">
            <label class="toggle">
                <input name="litFire" type="checkbox" value="true" />
                <span>Tänt</span>
            </label>
            <label class="toggle">
                <input name="stokedFire" type="checkbox" value="true" />
                <span>Lagt på</span>
            </label>
        </div>
    </fieldset>

    <fieldset>
        <legend><label for="notes">Övrigt</label></legend>
        <textarea id="notes" name="notes" rows="3" placeholder="Valfritt"></textarea>
    </fieldset>

    <div class="actions">
        <button type="submit">Spara</button>
    </div>
</form>
